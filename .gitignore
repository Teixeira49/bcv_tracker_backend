# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc

# Virtual Environment
venv/

# Environment variables (se ignoran todos los .env* salvo la plantilla pública)
.env*
!.env.example

# Logs and others
git_history.txt

# Documentación interna (NO se versiona).
# Sí se versionan: docs/DEPLOYMENT.md y docs/release/.
# - docs/schema/: esquema semántico interno de la BD
# - docs/PENDIENTES.md: notas de planificación / roadmap interno
# - docs/pull-requests/: borradores de PR (el PR canónico vive en GitHub)
# - docs/research/: investigación interna (playbook de integraciones)
docs/schema/
docs/PENDIENTES.md
docs/pull-requests/
docs/research/

# Tooling agéntico (skills / rules / roles)
# SÍ se versiona: .agents/, .claude/pr-config.json y skills-lock.json
# NO se versiona (config personal / local del asistente y posibles secretos):
.claude/settings.local.json
.claude/*.local.json
.mcp.local.json
.vercel
