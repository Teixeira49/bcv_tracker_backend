# Plantilla de variables de entorno de DolarTracker.
# Copia este archivo a `.env` y rellena los valores. La app valida al arrancar
# que todas existan (falla con un mensaje que nombra la que falte).
#
#   cp .env.example .env
#
# NOTA: `.env` está en .gitignore y nunca se versiona. Aquí NO pongas secretos:
# los valores de las URLs son los proveedores públicos usados por el proyecto.

# Cadena de conexión a PostgreSQL (usa tus propias credenciales).
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db

# BCV — tasas oficiales (scraping del portal).
OFFICIAL_MARKET_DATA_PROVIDER_URL=https://www.bcv.org.ve

# Binance P2P — mercado cripto (USDT/USDC).
MARKET_DATA_PROVIDER_A_URL=https://p2p.binance.com

# Yadio.io — mercado paralelo.
MARKET_DATA_PROVIDER_B_URL=https://api.yadio.io

# Bybit P2P — mercado cripto (USDT/USDC).
MARKET_DATA_PROVIDER_C_URL=https://api2.bybit.com

# Airtm — tasas de compra/venta del dólar (USD/VES), JSON público.
MARKET_DATA_PROVIDER_D_URL=https://rates.airtm.io

# Exchange Monitor — agregador de mercados (scraping híbrido CSRF + JSON).
MARKET_DATA_PROVIDER_F_URL=https://exchangemonitor.net
